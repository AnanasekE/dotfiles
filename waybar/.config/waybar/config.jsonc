{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 1,
  "modules-left": ["hyprland/workspaces"],
  "modules-right": [
    "tray",
    //    "network",
    "backlight",
    "pulseaudio",
    "pulseaudio#microphone",
    //    "memory",
    //    "cpu",
    "battery",
    "clock",
    "custom/power",
  ],
  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "cursor": true,
    "format": "{icon}",
    "persistent-workspaces": {
      "*": [1, 2, 3, 4, 5],
    },
  },
  "custom/power": {
    "format": "",
    "on-click": "~/.config/waybar/powermenu.sh",
    "tooltip": false,
  },
  "network": {
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format": "{icon}  {essid}",
    "format-wifi": "{icon}  {essid}",
    "format-ethernet": "󰀂",
    "format-disconnected": "󰤮",
    "tooltip-format-wifi": "{essid} ({frequency} GHz)\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-ethernet": "⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 3,
    "spacing": 1,
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "on-click-right": "pamixer -t",
    "tooltip-format": "Playing at {volume}%",
    "scroll-step": 5,
    "format-muted": " {volume}%",
    "format-icons": {
      "headphone": "",
      "headset": "",
      "default": ["", "", ""],
    },
  },
  "pulseaudio#microphone": {
    "format": "{format_source}",
    "format-source": " {volume}%",
    "format-source-muted": " ",
    "on-click-right": "pamixer --default-source -t",
    "scroll-step": 5,
  },
  "backlight": {
    "format": "{icon} {percent}%",
    "format-icons": ["🌑", "🌘", "🌗", "🌖", "🌕"],
  },
  "battery": {
    "format": "{icon} {capacity}%",
    "format-charging": "󱐋 {capacity}%",
    "format-plugged": " {capacity}%",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip-format": "{timeTo} {power}W",
    "interval": 10,
  },
  "memory": {
    "format": " {used:0.1f}gb",
    "interval": 2,
  },
  "cpu": {
    "interval": 5,
    "format": "󰍛 {usage}%",
  },
  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%A %d/%m/%Y}",
    "tooltip-format": "<span>{calendar}</span>",
  },
  "tray": {
    "spacing": 10,
  },
}
